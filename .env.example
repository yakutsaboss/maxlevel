# ==============================================
# Telegram RPG Quest Bot - Environment Variables
# ==============================================
# Copy this file to .env and fill in your actual values
# Never commit .env to version control!

# ==============================================
# TELEGRAM BOT (REQUIRED)
# ==============================================
# Get your bot token from @BotFather on Telegram
# Example: 123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ==============================================
# DATABASE (REQUIRED)
# ==============================================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database_name
# Example: postgresql://postgres:mypassword@localhost:5432/telegram_rpg
DATABASE_URL=postgresql://username:password@localhost:5432/telegram_rpg

# ==============================================
# PYTHON EXECUTABLE (REQUIRED)
# ==============================================
# Path to Python executable
# Windows: Usually "python" or "python.exe"
# Linux/Mac: Usually "python3"
PYTHON_EXECUTABLE=python

# ==============================================
# AI SERVICES (OPTIONAL)
# ==============================================
# OpenAI API Key (for GPT-4, GPT-3.5, embeddings, etc.)
# Get from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...

# Anthropic API Key (for Claude)
# Get from: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-...

# ==============================================
# GOOGLE APIs (OPTIONAL)
# ==============================================
# Used for Google Sheets, Drive, etc.
# Set up OAuth2 credentials and download credentials.json
# The token.json will be generated automatically on first use
# GOOGLE_APPLICATION_CREDENTIALS=credentials.json

# ==============================================
# APPLICATION SETTINGS (OPTIONAL)
# ==============================================
# Environment: development, staging, production
NODE_ENV=development

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Timezone for scheduled tasks
# Example: America/New_York, Europe/London, Asia/Tokyo
TIMEZONE=UTC

# ==============================================
# WEB APP / MINI APP (OPTIONAL)
# ==============================================
# Base URL for Telegram Mini App
# MINI_APP_URL=https://your-domain.com

# JWT Secret for Mini App authentication
# Generate a secure random string
# JWT_SECRET=your_jwt_secret_here

# ==============================================
# EXTERNAL SERVICES (OPTIONAL)
# ==============================================
# Timeweb Cloud API (if using cloud deployment tools)
# TIMEWEB_API_TOKEN=your_timeweb_token

# Other service API keys as needed
# SOME_SERVICE_API_KEY=your_key_here

# ==============================================
# DEVELOPMENT TOOLS (OPTIONAL)
# ==============================================
# Enable debug mode
# DEBUG=false

# Enable verbose logging
# VERBOSE=false
