# ==============================================
# Telegram RPG Quest Bot - Environment Variables
# ==============================================
# Copy this file to .env and fill in your actual values.
# Never commit .env to version control!
#
# Legend:
#   [REQUIRED]  - App will not start without this
#   [OPTIONAL]  - Has a sensible default or only needed for specific features
#   [DEV-ONLY]  - Only used in development mode

# ==============================================
# TELEGRAM BOT [REQUIRED]
# ==============================================
# Get your bot token from @BotFather on Telegram
# Example: 123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ==============================================
# DATABASE [REQUIRED]
# ==============================================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/telegram_rpg

# ==============================================
# MINI APP [REQUIRED]
# ==============================================
# Full URL where the Telegram Mini App is hosted
# Used by the bot to generate inline keyboard links
MINI_APP_URL=https://your-domain.com/levelapp

# ==============================================
# ADMIN AUTHENTICATION [REQUIRED FOR ADMIN API]
# ==============================================
# Admin username (default: admin)
ADMIN_USERNAME=admin

# SHA-256 hash of the admin password
# Generate: node -e "console.log(require('crypto').createHash('sha256').update('your_password').digest('hex'))"
ADMIN_PASSWORD_HASH=your_sha256_hash_here

# ==============================================
# SERVER [OPTIONAL]
# ==============================================
# Environment: development, staging, production
NODE_ENV=development

# API server port (default: 3000)
API_PORT=3000

# Log level: debug, info, warn, error (default: debug in dev, info in prod)
LOG_LEVEL=info

# ==============================================
# WEBHOOK [OPTIONAL — required in production]
# ==============================================
# Set to 'true' to use webhook mode instead of long polling
USE_WEBHOOK=false

# Domain for webhook URL (e.g. https://yakutsa.ru)
# Required when USE_WEBHOOK=true
WEBHOOK_DOMAIN=https://your-domain.com

# Secret for verifying Telegram webhook requests
# If not set, TELEGRAM_BOT_TOKEN is used as fallback
# TELEGRAM_WEBHOOK_SECRET=your_webhook_secret_here

# ==============================================
# PYTHON TOOLS [OPTIONAL]
# ==============================================
# Path to Python executable (default: python)
# Windows: python or python.exe
# Linux/Mac: python3
PYTHON_EXECUTABLE=python

# Path to Python tools directory (default: ./tools)
# Relative to project root when PM2 CWD is project root
PYTHON_TOOLS_PATH=./tools

# ==============================================
# BUILD METADATA [OPTIONAL — set by deploy script]
# ==============================================
# These are set automatically by scripts/deploy.sh
# BUILD_VERSION=dev
# BUILD_TIMESTAMP=2026-01-01T00:00:00.000Z

# ==============================================
# AI SERVICES [OPTIONAL]
# ==============================================
# OpenAI API Key (for GPT-4, GPT-3.5, embeddings, etc.)
# Get from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...

# Anthropic API Key (for Claude)
# Get from: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-...

# ==============================================
# GOOGLE APIs [OPTIONAL]
# ==============================================
# Used for Google Sheets, Drive, etc.
# Set up OAuth2 credentials and download credentials.json
# GOOGLE_APPLICATION_CREDENTIALS=credentials.json

# ==============================================
# EXTERNAL SERVICES [OPTIONAL]
# ==============================================
# Timeweb Cloud API (for deployment tools)
# TIMEWEB_API_TOKEN=your_timeweb_token

# ==============================================
# DEVELOPMENT ONLY [DEV-ONLY]
# ==============================================
# Skip Telegram auth validation (NEVER enable in production!)
# SKIP_AUTH=true

# Skip rate limiting (NEVER enable in production!)
# SKIP_RATE_LIMIT=true

# Timezone for scheduled tasks (default: UTC)
# TIMEZONE=UTC
